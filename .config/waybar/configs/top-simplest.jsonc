// ### TOP Simpliests ## //

{
  "include": [
    "$HOME/.config/waybar/modules.jsonc",
    "$HOME/.config/waybar/modules-workspaces.jsonc",
    "$HOME/.config/waybar/modules-custom.jsonc",
    "$HOME/.config/waybar/modules-groups.jsonc",
    "$HOME/.config/waybar/user-modules.jsonc"
  ],
  "layer": "top",
  "position": "top",
  //"mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin-left": 6,
  "margin-right": 6,
  "margin-top": 2,

  "modules-left": [
    "hyprland/workspaces",
    "tray",
    "mpris"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "idle_inhibitor",
    "custom/nightlight",
    "group/notify"
  ]
}
