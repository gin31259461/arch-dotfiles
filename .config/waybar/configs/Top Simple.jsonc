// ### TOP Simple ## //

{
  "include": [
    "$HOME/.config/waybar/modules/core-v1.jsonc",
    "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
    "$HOME/.config/waybar/modules/custom-v1.jsonc",
    "$HOME/.config/waybar/modules/groups-v1.jsonc",
    "$HOME/.config/waybar/modules/user-v1.jsonc"
  ],
  "layer": "top",
  "position": "top",
  //"mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin-left": 6,
  "margin-right": 6,
  "margin-top": 2,

  "modules-left": [
    "idle_inhibitor",
    "group/mobo_drawer",
    "hyprland/workspaces#rw",
    "tray",
    "mpris"
  ],

  "modules-center": [
    "clock#2",
    "group/notify"
  ],

  "modules-right": [
    "hyprland/window",
    "battery",
    "group/audio",
    "custom/nightlight",
    "custom/power"
  ]
}
