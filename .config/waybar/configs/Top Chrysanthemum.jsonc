//* ............................................*/
//* --- 👍 designed by https://github.com/Krautt 👍 --- */

{
  "include": [
    "$HOME/.config/waybar/modules/core-v1.jsonc",
    "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
    "$HOME/.config/waybar/modules/custom-v1.jsonc",
    "$HOME/.config/waybar/modules/groups-v1.jsonc",
    "$HOME/.config/waybar/modules/user-v1.jsonc"
  ],
  "layer": "top",
  //"mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 5,
  "fixed-center": true,
  "ipc": true,
  "margin-left": 5,
  "margin-right": 5,
  "margin-top": 0,

  "modules-left": [
    "clock#5",
    "mpris",
    "tray",
    "group/notify"
  ],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": [
    "pulseaudio#1",
    "backlight#2",
    "battery",
    "custom/nightlight"
  ]
}
