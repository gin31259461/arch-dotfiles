// ### Minimal -SHORT ### //

{
  "include": [
    "$HOME/.config/waybar/modules/core-v1.jsonc",
    "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
    "$HOME/.config/waybar/modules/custom-v1.jsonc",
    "$HOME/.config/waybar/modules/groups-v1.jsonc",
    "$HOME/.config/waybar/modules/user-v1.jsonc"
  ],
  "layer": "top",
  "position": "top",
  "width": 1050,
  "margin-top": 3,

  "modules-left": [
    "clock",
    "custom/weather"
  ],

  "modules-center": [
    "hyprland/workspaces#roman"
  ],

  "modules-right": [
    "custom/menu",
    "tray",
    "group/notify",
    "mpris",
    "network",
    "bluetooth",
    "backlight",
    "pulseaudio",
    "battery",
    "custom/nightlight",
    "custom/power"
  ]
}
