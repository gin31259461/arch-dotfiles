/* ### DUAL TOP and BOTTOM v 2### */

[
  {
    "include": [
      "$HOME/.config/waybar/modules/core-v1.jsonc",
      "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
      "$HOME/.config/waybar/modules/custom-v1.jsonc",
      "$HOME/.config/waybar/modules/groups-v1.jsonc",
      "$HOME/.config/waybar/modules/user-v1.jsonc"
    ],
    "name": "topbar",
    "layer": "top",
    "position": "top",
    //"mode": "dock",
    "exclusive": true,
    "spacing": 2,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
      "group/app_drawer",
      "keyboard-state",
      "clock",
      "bluetooth",
      "network"
    ],
    "modules-center": ["hyprland/window"],
    "modules-right": [
      "mpris",
      "battery",
      "backlight",
      "pulseaudio",
      "group/mobo_drawer",
      "idle_inhibitor",
      "custom/nightlight",
      "group/power"
    ]
  },
  {
    "include": [
      "$HOME/.config/waybar/modules/core-v1.jsonc",
      "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
      "$HOME/.config/waybar/modules/custom-v1.jsonc",
      "$HOME/.config/waybar/modules/groups-v1.jsonc",
      "$HOME/.config/waybar/modules/user-v1.jsonc"
    ],
    "name": "bottombar",
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "mode": "dock",
    "exclusive": true,
    "spacing": 2,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces#rw"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": ["tray", "custom/updater", "group/notify"]
  }
]
