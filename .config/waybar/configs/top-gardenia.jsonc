{
  "include": [
    "$HOME/.config/waybar/modules.jsonc",
    "$HOME/.config/waybar/modules-workspaces.jsonc",
    "$HOME/.config/waybar/modules-custom.jsonc",
    "$HOME/.config/waybar/modules-groups.jsonc",
    "$HOME/.config/waybar/user-modules.jsonc"
  ],
  "layer": "top",
  //"mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 5,
  "fixed-center": false,
  "ipc": true,
  "margin-top": 5,
  //"margin-bottom": 5,
  "width": 1000,

  "modules-left": [
    "clock#5",
    "mpris",
    "tray",
    "group/notify"
  ],

  "modules-center": ["hyprland/workspaces#kanji"],

  "modules-right": [
    "pulseaudio#1",
    "backlight#2",
    "battery",
    "custom/nightlight"
  ]
}
