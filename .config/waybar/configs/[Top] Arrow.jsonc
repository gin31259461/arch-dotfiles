/* .....[TOP] Arrow Best to combine with [Extra] Arrow Style ......... */
/* --- 👍 taken from https://github.com/mxkrsv 👍 --- */

{
  "include": [
    "$HOME/.config/waybar/modules/core-v1.jsonc",
    "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
    "$HOME/.config/waybar/modules/custom-v1.jsonc",
    "$HOME/.config/waybar/modules/groups-v1.jsonc",
    "$HOME/.config/waybar/modules/user-v1.jsonc"
  ],

  "layer": "top",
  "position": "top",

  "modules-left": [
    "hyprland/mode",
    "hyprland/workspaces",
    "custom/arrow10",
    "hyprland/window"
  ],

  "modules-right": [
    "custom/arrow9",
    "pulseaudio",
    "custom/arrow8",
    "network",
    "custom/arrow7",
    "memory",
    "custom/arrow6",
    "cpu",
    "custom/arrow5",
    "temperature",
    "custom/arrow4",
    "battery",
    "custom/arrow2",
    "tray",
    "custom/arrow1",
    "custom/nightlight",
    "clock#2"
  ]
}
