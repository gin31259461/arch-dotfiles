// ### DEFAULT Laptop - Top ### //
{
  "include": [
    "$HOME/.config/waybar/modules/core-v1.jsonc",
    "$HOME/.config/waybar/modules/workspaces-v1.jsonc",
    "$HOME/.config/waybar/modules/custom-v1.jsonc",
    "$HOME/.config/waybar/modules/groups-v1.jsonc",
    "$HOME/.config/waybar/modules/user-v1.jsonc"
  ],
  "layer": "top",
  //"mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 3,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "custom/separator#blank",
    "custom/cava_mviz",
    "custom/separator#blank",
    "custom/playerctl",
    "hyprland/window"
  ],

  "modules-center": [
    "group/app_drawer",
    "custom/separator#blank",
    "group/notify",
    "hyprland/workspaces#rw",
    "clock",
    "custom/weather",
    "idle_inhibitor",
    "custom/hint"
  ],

  "modules-right": [
    "tray",
    "group/laptop",
    "group/mobo_drawer",
    "group/audio",
    "custom/nightlight",
    "group/status"
  ]
}
