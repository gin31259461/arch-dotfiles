{
"include": [
  "$HOME/.config/waybar/modules.jsonc",
  "$HOME/.config/waybar/modules-workspaces.jsonc",
  "$HOME/.config/waybar/modules-custom.jsonc",
  "$HOME/.config/waybar/modules-groups.jsonc",
  "$HOME/.config/waybar/user-modules.jsonc",
  ],
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "bottom",
"spacing": 5,
"fixed-center": true,
"ipc": true,
"margin-left": 5,
"margin-right": 5,
"margin-top": 0,

"modules-left": [
	"clock#5",
	"mpris",
	"tray",
	"group/notify"
	],

"modules-center": ["hyprland/workspaces"],

"modules-right": [
	"pulseaudio#1",
	"backlight#2",
	"power-profiles-daemon",
	"battery"],

}
